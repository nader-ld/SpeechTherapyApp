{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Speech Practice exercise library",
  "description": "Exercise library and weekly plan consumed by the Speech Practice app.",
  "type": "object",
  "required": [
    "version",
    "categories",
    "exercises",
    "weeks"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner": {
          "type": "string"
        },
        "therapist": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/category"
      }
    },
    "exercises": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/exercise"
      }
    },
    "weeks": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/week"
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "kebab-case identifier"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO date, YYYY-MM-DD"
    },
    "source": {
      "enum": [
        "therapist",
        "self"
      ],
      "description": "Where this came from: assigned in therapy, or added by me"
    },
    "category": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "item": {
      "description": "A prompt: a word, phrase, sentence or passage. Plain string or object with a note.",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "$ref": "#/definitions/source"
            },
            "note": {
              "type": "string",
              "description": "Shown under the prompt during practice"
            },
            "answer": {
              "type": "string",
              "description": "Hidden during practice until the user taps Show answer. Set answerSource when it was not in the therapist's material."
            },
            "timerSec": {
              "type": "integer",
              "minimum": 5,
              "maximum": 3600,
              "description": "Countdown offered on this prompt; overrides the exercise's itemTimerSec"
            },
            "answerSource": {
              "$ref": "#/definitions/source",
              "description": "Who wrote the answer: therapist (from the worksheet) or self (written for this app). Defaults to the item's source."
            }
          }
        }
      ]
    },
    "exercise": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "mode",
        "instructions"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "$ref": "#/definitions/id"
        },
        "mode": {
          "enum": [
            "items",
            "timed",
            "reps"
          ],
          "description": "items = step through prompts; timed = countdown; reps = tap counter"
        },
        "instructions": {
          "type": "string",
          "minLength": 1
        },
        "tips": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/item"
          }
        },
        "durationSec": {
          "type": "integer",
          "minimum": 5,
          "description": "Required for mode=timed"
        },
        "targetReps": {
          "type": "integer",
          "minimum": 1,
          "description": "Required for mode=reps"
        },
        "paceBpm": {
          "type": "integer",
          "minimum": 20,
          "maximum": 240,
          "description": "Enables the metronome at this tempo"
        },
        "source": {
          "$ref": "#/definitions/source"
        },
        "addedOn": {
          "$ref": "#/definitions/date"
        },
        "itemTimerSec": {
          "type": "integer",
          "minimum": 5,
          "maximum": 3600,
          "description": "Countdown offered on every prompt (mode=items), e.g. 30 for a 30-second pitch"
        }
      }
    },
    "week": {
      "type": "object",
      "required": [
        "id",
        "focus",
        "exerciseIds"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Shown as the heading, e.g. 'Activity #3'. Falls back to 'Week of <startDate>'."
        },
        "startDate": {
          "$ref": "#/definitions/date",
          "description": "Optional. Monday of the week; used for 'this week' stats and to hide future weeks"
        },
        "focus": {
          "type": "string",
          "minLength": 1
        },
        "therapistNotes": {
          "type": "string"
        },
        "exerciseIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/id"
          }
        }
      },
      "description": "One therapy session / week. List oldest first; the app treats the last one that has started as current (undated weeks always count as started)."
    }
  }
}
